# Kopieer dit bestand naar .env en pas aan. Zet .env NOOIT op GitHub.

# --- Camera -----------------------------------------------------------------
# 0 = eerste webcam, 1 = tweede webcam
# picamera = Raspberry Pi Camera Module
# http://<ip-van-pi>:8000/stream.mjpg?token=... = beeld van pi_stream.py
# rtsp://... = IP-camera of drone met RTSP-stream
# pad/naar/video.mp4 of foto.jpg = testen zonder camera
CAMERA_SOURCE=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
# Beelden per seconde van de camera. De Raspberry Pi AI Camera (IMX500) kan
# maximaal 30. 60 kan alleen met een camera die dat echt kan (snelle webcam,
# Camera Module 3); zet dan ook STREAM_FPS op 60.
CAMERA_FPS=30
# Beelden worden voor de AI verkleind tot deze breedte (kleiner = sneller)
PROCESS_WIDTH=960

# --- Objectherkenning --------------------------------------------------------
# auto = de AI Camera (IMX500) als die er is (met CAMERA_SOURCE=picamera),
#        anders YOLO11 als ultralytics/PyTorch werkt, anders YOLOX via OpenCV
# imx500 / yolo / opencv / uit
OBJECT_BACKEND=auto
YOLO_MODEL=yolo11n.pt
# Model voor de AI Camera. Leeg = SSD MobileNetV2 uit het pakket imx500-all
# (/usr/share/imx500-models/imx500_network_ssd_mobilenetv2_fpnlite_320x320_pp.rpk)
IMX500_MODEL=
OBJECT_CONFIDENCE=0.45
# YOLO draait naast de livestream. Na elke ronde wacht hij eerst N nieuwe
# beelden af, zodat er rekenkracht overblijft (op de Pi bijv. 3).
# Geldt niet voor de AI Camera: die herkent elk beeld zelf.
OBJECT_EVERY=1

# --- Gezichtsherkenning ------------------------------------------------------
FACE_DETECT_THRESHOLD=0.8
# Hoger = strenger (minder vergissingen, maar vaker "onbekend")
FACE_MATCH_THRESHOLD=0.363

# --- Meldingen ---------------------------------------------------------------
# Seconden voordat dezelfde persoon opnieuw een melding geeft
ALERT_COOLDOWN=30

# --- Website -----------------------------------------------------------------
HOST=0.0.0.0
PORT=5000
STREAM_FPS=30
JPEG_QUALITY=80

# --- Slimme AI (Claude) ------------------------------------------------------
# Maak een sleutel op https://console.anthropic.com. Leeg = lokale assistent.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low = snel en goedkoop, medium/high = grondiger maar trager
CLAUDE_EFFORT=low

# --- Alleen voor pi_stream.py (op de Raspberry Pi) ---------------------------
STREAM_PORT=8000
STREAM_TOKEN=
